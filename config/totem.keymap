//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        macro_seq1: seq_one {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp U &kp R &kp T>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp N1 &kp ENTER>;
        };

        macro_seq2: seq_two {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp U &kp R &kp T>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp N2 &kp ENTER>;
        };

        tip: tip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(H) &kp A &kp O &kp LS(P) &kp H &kp E &kp I &kp AT &kp N1 &kp N2 &kp N8 &kp RET>;
            label = "TIP";
        };

        ctrl_alt_del: ctrl_alt_del {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LALT>,
                <&macro_tap>,
                <&kp DEL>,
                <&macro_release>,
                <&kp LCTRL &kp LALT>;
            label = "CTRL_ALT_DEL";
        };
    };

    behaviors {
        td_seq: tap_dance_sequence {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&macro_seq1>, <&macro_seq2>;
        };

        td_custom: tap_dance_custom {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&tip>, <&ctrl_alt_del>;
        };

        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
        };

        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
            &kp Q        &kp W        &kp E           &kp R      &kp T          &kp Y        &kp U          &kp I        &kp O        &kp P
            &kp A        &kp S        &kp D           &kp F      &kp G          &kp H        &kp J          &kp K        &kp L        &kp SEMI
&kp ESCAPE  &kp Z        &kp X        &kp C           &kp V      &kp B          &kp N        &kp M          &kp COMMA    &kp DOT      &kp FSLH     &kp BACKSPACE
                                      &kp LEFT_SHIFT  &kp LCTRL  &lt 1 ENTER    &lt 2 SPACE  &kp TAB        &kp RIGHT_ALT
            >;
        };

        nav_num {
            bindings = <
        &kp NUMBER_1  &kp NUMBER_2  &kp N3    &kp N4      &kp NUMBER_5    &kp N6     &kp N7         &kp N8        &kp N9                &kp N0
        &kp EXCL      &kp AT        &kp HASH  &kp DOLLAR  &kp PRCNT       &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp F1  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_CLR  &swapper  &td_seq         &trans     &trans         &trans        &trans                &trans                 &kp TILDE
                                            &trans      &trans          &trans     &trans         &trans        &trans
            >;
        };

        sym_func {
            bindings = <
        &kp COLON  &kp UNDERSCORE    &kp SLASH         &kp NON_US_BACKSLASH  &kp QUESTION       &trans            &trans             &trans             &trans            &trans
        &kp MINUS  &kp GREATER_THAN  &kp PIPE          &kp PLUS              &kp EQUAL          &kp LEFT_ARROW    &kp DOWN_ARROW     &kp UP_ARROW       &kp RIGHT_ARROW   &kp SEMICOLON
&trans  &trans     &kp LESS_THAN     &kp GREATER_THAN  &kp LEFT_BRACE        &kp RIGHT_BRACE    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &trans         &td_custom
                                                       &trans                &trans             &trans            &none              &trans             &none
            >;
        };

        device {
            bindings = <
       &none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
&none  &none       &none                 &none                 &none             &none    &none         &none         &none         &none         &bt BT_CLR    &none
                                                               &none             &none    &none         &none         &none         &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
